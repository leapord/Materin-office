{
	"name": "materin-office",
	"version": "0.1.1",
	"description": "Obsidian plugin that reads, edits and saves Office files (docx, xlsx, pptx, xls, doc, ppt) with faithful write-back.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"check": "tsc -noEmit -skipLibCheck",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"office",
		"docx",
		"xlsx",
		"pptx"
	],
	"author": "qiyuyang",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.10.0",
		"@xmldom/xmldom": "^0.9.12",
		"esbuild": "^0.25.0",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"jsdom": "^29.1.1",
		"obsidian": "latest",
		"tslib": "^2.8.1",
		"typescript": "^5.8.0",
		"typescript-eslint": "^8.68.0",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"docx-preview": "0.4.0",
		"exceljs": "4.4.0",
		"jszip": "3.10.2",
		"word-extractor": "1.0.4",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	}
}
